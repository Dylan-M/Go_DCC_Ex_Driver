<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.github.dylanm.go_dccex_driver" android:versionCode="@VERSION_CODE@" android:versionName="@VERSION_NAME@">
  <application android:label="DCC-EX Throttle" android:debuggable="true">
    <activity android:name="org.golang.app.GoNativeActivity"
        android:label="DCC-EX Throttle" android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|keyboardHidden|uiMode"
        android:theme="@android:style/Theme">
      <meta-data android:name="android.app.lib_name" android:value="dccex" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <receiver android:name="org.golang.app.FyneNotificationReceiver" android:exported="false" />
  </application>
  <!-- Settings stay in private app storage; no shared-storage permission is needed. -->
  <uses-permission android:name="android.permission.INTERNET" />
</manifest>
